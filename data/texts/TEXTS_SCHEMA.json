  "file_structure": {
    "text_directory": {
      "passages_angelology.json": "HARVESTER output: extracted angelology passages with context",
      "passages_angelology_manifest.json": "Work queue: task assignments for PORTER + SYNTHESIZER",
      "entries": {
        "description": "Standardized conclusion entries (PORTER output)",
        "format": "T.section.number.json (e.g., O.1.1.json = Oration section 1 conclusion 1)"
      },
      "exegeses": {
        "description": "Exegesis markdown files (SYNTHESIZER output)",
        "format": "T.section.number_exegesis.md"
      },
      "research_notes.md": "SYNTHESIZER research summary for this text"
    },
    "scholarships_shared": {
      "location": "data/scholarships/angels/",
      "lineage_pseudodionysius.json": "References to Pseudo-Dionysius across all four texts",
      "lineage_aquinas.json": "References to Aquinas scholasticism",
      "lineage_kabbalah.json": "References to Kabbalah + Sefirot correspondence",
      "lineage_plotinus.json": "References to Plotinian emanation",
      "scholar_debate_log.json": "Documented disagreements (Wirszubski vs. Allen, etc.)"
    }
  },
  "passage_entry_template": {
    "passage_id": "string (e.g., 'O.1.2')",
    "text_id": "string (oration|commento|heptaplus|being_unity)",
    "section_number": "integer (section within text)",
    "incipit_latin": "string (opening words in Latin)",
    "quote_latin": "string (full Latin passage from source)",
    "quote_english": "string (English translation, with source)",
    "quote_length_words": "integer",
    "context": "string (what is Pico arguing in this passage?)",
    "lineage_tags": [
      "pseudo-dionysius | aquinas | kabbalah | plotinus | synthesis"
    ],
    "cross_references": [
      "string (e.g., 'Heptaplus Layer 2, Day 1'; 'Commento Book I'; '900 Conclusions I.1.5')"
    ],
    "scholarly_citations_available": [
      "string (scholar names: Howlett, Edelheit, Wirszubski, Black, Allen, Busi, Akopyan)"
    ],
    "heretical_adjacent": "boolean (is this passage relevant to heretical conclusions Q1, Q6, Q8?)",
    "source_file_location": "string (which Markdown file in E:\\pdf\\)",
    "harvester_notes": "string (optional notes from extraction agent)"
  },
  "entry_json_template": {
    "conclusion_id": "string (T.section.number)",
    "text": "oration|commento|heptaplus|being_unity",
    "section": "integer",
    "passage_number": "integer",
    "latin_text": "string",
    "english_translation": "string",
    "translation_source": "string (megabase | PicoDB | original_translation_2026)",
    "exegesis": "string (1-2 paragraph explanation)",
    "exegesis_status": "draft|complete",
    "lineage": "pseudo-dionysius|aquinas|kabbalah|plotinus|synthesis",
    "key_concepts": [
      "string (e.g., 'divine embodiment', 'intellective ascent', 'Sefirotic correspondence')"
    ],
    "tags": [
      "angelology|heretical_adjacent|mystical|magical|astrological|kabbalistic|etc"
    ],
    "cross_references": {
      "same_text": ["passage_ids"],
      "other_texts": ["passage_ids from other Oration|Commento|Heptaplus|BeingUnity"],
      "900_conclusions": ["conclusion_ids"]
    },
    "scholar_citations": [
      {
        "scholar": "string (Last name)",
        "work": "string (Short title)",
        "quotation": "string (verbatim quote)",
        "confidence": "VERIFIED|CITED|INFERRED",
        "relevance": "string (how this supports understanding)"
      }
    ],
    "status": "unstarted|sourced|draft|complete|reviewed",
    "porter_notes": "string",
    "synthesizer_notes": "string"
  },
