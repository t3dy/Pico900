        "Wirszubski (Angelology in Kabbalah context)"
      ],
      "directory": "data/texts/commento"
    },
    "heptaplus": {
      "full_title": "Heptaplus: On the Sevenfold Narration of the Six Days of Creation",
      "latin_title": "Heptaplus",
      "short_id": "H",
      "year": 1489,
      "estimated_passages": 50,
      "angelology_focus": [
        "Layer 1 (Literal): Angels created on Day 1 as light/intellect",
